cat > .gitignore << 'EOF'
# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Archivos generados por pip install -e .
*.egg-info/
build/
dist/

# Datos y modelos entrenados (solo los de la raíz del repo)
/data/
/models/
*.pt
*.pth
*.h5
*.keras
*.pkl

# Credenciales
*.env
kaggle.json

# Sistema
.DS_Store
Thumbs.db
EOF